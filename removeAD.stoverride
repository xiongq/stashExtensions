name: YouTube (画中画终极修复版)
desc: 修复 Stash 下 max-size 导致二进制脚本失效及 initplayback 请求阶段拦截问题
icon: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/youtube.png

rules:
  # 强制阻断 UDP 443 (QUIC)，确保 100% 走 HTTPS 触发脚本
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
  - AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
  - AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP)),REJECT
  - AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP)),REJECT

http:
  mitm:
    - "*.googlevideo.com"
    - "youtubei.googleapis.com"
    - "youtubei-att.googleapis.com"
    - "youtube.com"
    - "www.youtube.com"
    - "m.youtube.com"
    - "s.youtube.com"

  url-rewrite:
    # 拦截广告请求与 initplayback 预加载
    - ^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads|videoplayback\?).+&oad - reject-200
    - ^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200
    - ^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject-200
    - ^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject-200

  header-rewrite:
    - ^https?:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\/ response-del Alt-Svc

  script:
    # 1. 关键修复：initplayback 必须是 type: request（请求阶段拦截），逼迫客户端走 /player 接口解锁画中画
    - match: ^https:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*
      name: YouTube_Enhance_Response
      type: request
      require-body: true
      binary-mode: true
      timeout: 15
      argument: '{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":true,"debug":false}'

    # 2. 核心修复：移除导致脚本跳过的 max-size: -1，完整修改 player 与 setting 响应包，解锁画中画
    - match: ^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?(.*))?$
      name: YouTube_Enhance_Response
      type: response
      require-body: true
      binary-mode: true
      timeout: 20
      argument: '{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":true,"debug":false}'

script-providers:
  YouTube_Enhance_Response:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js
    interval: 86400
