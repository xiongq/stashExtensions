name: YouTube v1.2
desc: 强制拦截 QUIC、去广告、解锁画中画与后台播放
icon: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/youtube.png

# 使用 prepend 确保覆写规则插入在主配置规则的最前面！
rules:
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(NETWORK,UDP)),REJECT
  - AND,((DOMAIN-SUFFIX,youtube.com),(NETWORK,UDP)),REJECT
  - AND,((DOMAIN,youtubei.googleapis.com),(NETWORK,UDP)),REJECT
  - AND,((DOMAIN,youtubei-att.googleapis.com),(NETWORK,UDP)),REJECT
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
  - AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
  - AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP)),REJECT

http:
  mitm:
    - "youtubei.googleapis.com"
    - "youtubei-att.googleapis.com"
    - "youtube.com"
    - "www.youtube.com"
    - "m.youtube.com"
    - "music.youtube.com"
    - "*.googlevideo.com"

  url-rewrite:
    - ^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$ - reject-200

  header-rewrite:
    - ^https:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\/ response-del Alt-Svc

  script:
    # 1. 字幕翻译请求
    - match: ^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$
      name: YouTube_Request
      type: request
      require-body: false
      timeout: 10
      argument: '[true,"zh-CN"]'

    # 2. 客户端配置请求
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$
      name: YouTube_Request
      type: request
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '[false,"info","32","US"]'

    # 3. 播放请求与广告配置处理
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$
      name: YouTube_Request
      type: request
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '[false,"info","32","US"]'

    # 4. Onesie 配置缓存处理
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$
      name: YouTube_Response
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '[false,"info","32"]'

    # 5. 首页信息流广告与 Home Shorts 屏蔽
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$
      name: YouTube_Response
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '[false,"info","32",true,"",""]'

    # 6. 播放响应处理与后台播放/画中画解锁
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$
      name: YouTube_Response
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '[false,"info","32",true,false]'

script-providers:
  YouTube_Request:
    url: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js
    interval: 86400
  YouTube_Response:
    url: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js
    interval: 86400
