name: YouTube Stash (Maasea response diagnostic)
desc: Focused YouTube preroll-ad diagnosis using the Maasea response script. Does not reject initplayback or videoplayback requests. Requires trusted MITM certificate.
author: Stash override conversion
homepage: https://github.com/Maasea/sgmodule
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
category: YouTube
version: 1.4.0
arguments-version: 1
arguments:
  debug_enabled:
    type: switch
    title: Script debug logs
    description: Enable script-side debugging while checking whether player responses are processed.
    default: true

rules:
  # Stash's documented QUIC fallback approach: reject UDP/443 for YouTube APIs/media;
  # the connection should retry over TCP. The REJECT log itself is expected for these matches.
  - 'AND,((DOMAIN-SUFFIX,googlevideo.com),(NETWORK,udp),(DST-PORT,443)),REJECT'
  - 'AND,((DOMAIN,youtubei.googleapis.com),(NETWORK,udp),(DST-PORT,443)),REJECT'
  - 'AND,((DOMAIN,youtubei-att.googleapis.com),(NETWORK,udp),(DST-PORT,443)),REJECT'

http:
  mitm:
    - youtubei.googleapis.com
    - youtubei-att.googleapis.com
    - www.youtube.com
    - s.youtube.com
    - m.youtube.com
    - music.youtube.com
    - '-redirector*.googlevideo.com'
    - '*.googlevideo.com'

  # Block telemetry only. Do not intercept initplayback/videoplayback media bodies.
  url-rewrite:
    - '^https?:\/\/(?:www|s)\.youtube\.com\/api\/stats\/ads(?:[/?#].*)?$ - reject-200'
    - '^https?:\/\/(?:www|s)\.youtube\.com\/(?:pagead|ptracking)(?:[/?#].*)?$ - reject-200'
    - '^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext[^#]*$ - reject-200'

  script:
    # Keep the match focused on YouTube JSON API responses that can carry ad placement metadata.
    - name: youtube-response
      match: '^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?[^#]*)?$'
      type: response
      require-body: true
      binary-mode: true
      timeout: 60
      argument: '{"lyricLang":"off","captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":${args.debug_enabled|json}}'

  script-providers:
    youtube-response:
      url: https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js
      interval: 86400
