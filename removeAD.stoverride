name: YouTube (Stash preroll fix)
desc: Preroll-ad metadata filtering for Stash. Does not reject normal Googlevideo media URLs. Requires trusted MITM certificate.
author: devchristian1337 (Stash override conversion)
homepage: https://github.com/devchristian1337/loon-plugins/blob/main/README.md
icon: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/youtube.png
category: YouTube
version: 1.2.0
arguments-version: 1
arguments:
  playback_region:
    type: select
    title: Playback request region
    description: Changes the YouTube client gl parameter only; it does not change the exit IP.
    default: original
    options:
      - value: original
      - value: CN
      - value: HK
      - value: TW
      - value: US
      - value: JP
      - value: KR
      - value: SG
      - value: GB
      - value: DE
      - value: RU
  translation_enabled:
    type: switch
    title: Subtitle translation
    description: Translates existing subtitle tracks only. Videos without subtitles cannot be translated.
    default: false
  translation_target:
    type: select
    title: Subtitle target language
    default: zh-CN
    options:
      - value: zh-CN
      - value: en-US
  hide_home_shorts:
    type: switch
    title: Hide Home Shorts
    description: Removes the Shorts shelf from the Home feed; the Shorts tab and other pages remain.
    default: false
  blocked_channels:
    type: input
    title: Blocked channels
    description: Channel IDs, @handles, or full channel names separated by spaces. Prefer IDs; handles are best for names containing spaces.
    default: ''
    max-length: 8192
  blocked_channels_url:
    type: input
    title: Remote blocked channels URL
    description: Public HTTPS plain-text URL. Merged with the manual list; cache refreshes hourly.
    default: ''
    max-length: 2048
  log_enabled:
    type: switch
    title: Logging tool
    description: Enables API request/response logging. Media video-segment bodies are not intercepted in this stability-focused build.
    default: false
  log_level:
    type: select
    title: Log level
    default: info
    options:
      - value: info
      - value: debug
      - value: warn
      - value: error
  capture_budget:
    type: select
    title: Log capacity (MB)
    description: Recording stops when the limit is reached; existing samples are kept.
    default: '32'
    options:
      - value: '32'
      - value: '16'
      - value: '64'

rules:
  # Force YouTube API traffic away from UDP/443 so MITM can inspect player JSON responses.
  - 'AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT'
  - 'AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT'

http:
  mitm:
    - youtubei.googleapis.com
    - youtubei-att.googleapis.com
    - youtube.com
    - www.youtube.com
    - m.youtube.com
    - music.youtube.com

  # Direct ad/tracking URL filters. Do not reject initplayback or videoplayback wholesale;
  # this build intentionally does not block Googlevideo media requests.
  url-rewrite:
    - '^https?:\/\/(?:www|s)\.youtube\.com\/api\/stats\/ads(?:[/?#].*)?$ - reject-200'
    - '^https?:\/\/(?:www|s)\.youtube\.com\/(?:pagead|ptracking)(?:[/?#].*)?$ - reject-200'
    - '^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?[^#]*adcontext[^#]*$ - reject-200'

  # Remove ad scheduling metadata in player JSON responses. Never reject Googlevideo media streams.
  body-rewrite:
    - '^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:player|get_watch)(?:\?[^#]*)?$ response-jq walk(if type == "object" then del(.adPlacements, .adSlots, .playerAds, .adBreakHeartbeatParams) else . end)'

  script:
    # Subtitle translation: rewrite only existing timedtext subtitle requests.
    - match: '^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$'
      name: youtube-request
      type: request
      require-body: false
      timeout: 10
      argument: '{"translation_enabled":${args.translation_enabled|json},"translation_target":${args.translation_target|json}}'

    # Stash log-control page endpoint. Keep log_control=page isolated to this URL;
    # the bundled script intentionally disables normal sampling in page-control mode.
    - match: '^http://youtube-logs\.invalid(?::80)?(?:/[^#]*)?$'
      name: youtube-request
      type: request
      require-body: false
      timeout: 10
      argument: '{"log_control":"page","log_enabled":false,"log_level":${args.log_level|json},"capture_budget":${args.capture_budget|json}}'

    # Feed request logging only; do not intercept frequent video-segment requests.
    - match: '^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/(?:browse|next|search|reel/reel_watch_sequence)(?:\?[^#]*)?$'
      name: youtube-request
      type: request
      require-body: false
      timeout: 10
      argument: '{"log_enabled":${args.log_enabled|json},"log_level":${args.log_level|json},"capture_budget":${args.capture_budget|json}}'

    # YouTube log_event may contain binary/protobuf-like payloads.
    - match: '^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)/youtubei/v1/log_event(?:\?[^#]*)?$'
      name: youtube-request
      type: request
      require-body: true
      binary-mode: true
      timeout: 10
      argument: '{"log_enabled":${args.log_enabled|json},"log_level":${args.log_level|json},"capture_budget":${args.capture_budget|json},"playback_region":${args.playback_region|json}}'


    # Feed response: ad cleanup, Shorts shelf and blocked-channel filtering.
    - match: '^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)/youtubei/v1/(?:browse|next|search)(?:\?[^#]*)?$'
      name: youtube-response
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
      argument: '{"log_enabled":${args.log_enabled|json},"log_level":${args.log_level|json},"capture_budget":${args.capture_budget|json},"hide_home_shorts":${args.hide_home_shorts|json},"blocked_channels":${args.blocked_channels|json},"blocked_channels_url":${args.blocked_channels_url|json}}'


    # Onesie/config cache logging. Body is required by the source script.
    - match: '^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)/youtubei/v1/(?:config|log_event)(?:\?[^#]*)?$'
      name: youtube-response
      type: response
      require-body: true
      binary-mode: true
      timeout: 10
      argument: '{"log_enabled":${args.log_enabled|json},"log_level":${args.log_level|json},"capture_budget":${args.capture_budget|json}}'

  # Player ad metadata is filtered by body-rewrite; media segment requests/responses are not intercepted.
  # The Loon manual button is replaced by this hourly cache refresh.

cron:
  script:
    - name: youtube-request
      cron: '0 * * * *'
      timeout: 10
      argument: '{"blocked_channels_url":${args.blocked_channels_url|json}}'

script-providers:
  youtube-request:
    url: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js
    interval: 86400
  youtube-response:
    url: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js
    interval: 86400
