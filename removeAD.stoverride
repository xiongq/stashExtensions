name: YouTube v1.1
desc: 1:1 还原 devchristian1337 插件：去广告、后台/画中画播放、隐藏首页 Shorts、字幕翻译
icon: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/youtube.png

rules:
  # 1. 强制拦截 QUIC 与 UDP 443，迫使 YouTube 降级为 TCP 以接受 MITM 抓包和脚本处理
  - AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT
  - AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DST-PORT,443)),REJECT

http:
  mitm:
    - "youtubei.googleapis.com"
    - "youtubei-att.googleapis.com"
    - "youtube.com"
    - "www.youtube.com"
    - "m.youtube.com"
    - "music.youtube.com"
    - "*.googlevideo.com"

  url-rewrite:
    # 对应原插件 [Rewrite] 中的 initplayback 拦截
    - ^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$ - reject-200

  header-rewrite:
    # 对应原插件清除 Alt-Svc 头，防止重连 QUIC
    - ^https:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\/ response-del Alt-Svc

  script:
    # 1. 字幕翻译处理 (timedtext)
    - match: ^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$
      name: YouTube_Request
      type: request
      require-body: false
      timeout: 10
      argument: '{"translation_enabled":true,"translation_target":"zh-CN"}'

    # 2. 客户端配置请求处理 (log_event)
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$
      name: YouTube_Request
      type: request
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '{"log_enabled":false,"log_level":"info","capture_budget":"32","playback_region":"US"}'

    # 3. 播放请求与广告配置处理 (player | get_watch | ad_break)
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$
      name: YouTube_Request
      type: request
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '{"log_enabled":false,"log_level":"info","capture_budget":"32","playback_region":"US"}'

    # 4. Onesie 配置缓存处理 (config | log_event)
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$
      name: YouTube_Response
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '{"log_enabled":false,"log_level":"info","capture_budget":"32"}'

    # 5. 首页信息流广告与 Home Shorts 屏蔽 (browse | next | search)
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$
      name: YouTube_Response
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '{"log_enabled":false,"log_level":"info","capture_budget":"32","hide_home_shorts":true,"blocked_channels":"","blocked_channels_url":""}'

    # 6. 播放响应处理与后台播放/画中画解锁 (player | get_watch | reel_watch_sequence)
    - match: ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$
      name: YouTube_Response
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      argument: '{"log_enabled":false,"log_level":"info","capture_budget":"32","background_playback":true,"quality_research":false}'

script-providers:
  YouTube_Request:
    url: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/request.min.js
    interval: 86400
  YouTube_Response:
    url: https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/YouTube/response.min.js
    interval: 86400
